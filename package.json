{
  "main": "index.js",
  "homepage": "https://zikr.valabji.com/",
  "scripts": {
    "start": "expo start",
    "android": "rm -rf android && expo run:android",
    "eas": "npx dotenv-cli@latest -e .env -- npx eas-cli@latest",
    "eas:secret": "yarn eas env:create --scope project --visibility=secret ",
    "eas-build-pre-install": "./pre-install",
    "build:android": "yarn version && yarn eas build --profile production --platform android",
    "build:android:local": "yarn eas build --profile production --platform android --local",
    "lint:android": "expo prebuild --clean --platform android && cd android && ./gradlew lintVitalRelease",
    "build:ios": "yarn eas build --profile production --platform ios",
    "build:ios:local": "yarn eas build --profile production --platform ios --local",
    "predeploy": "npx expo export -p web --output-dir dist",
    "prebuild": "expo prebuild --clean",
    "deploy": "gh-pages -d dist --cname zikr.valabji.com",
    "ios": "expo run:ios",
    "ios:device": "bash scripts/ios-device.sh",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --coverage=false",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:update": "jest --updateSnapshot",
    "test:ci": "jest --ci",
    "ci:act": "act push -W .github/workflows/ci.yaml --container-architecture linux/amd64 -P ubuntu-latest=catthehacker/ubuntu:act-latest",
    "version": "node versioning.js",
    "version:auto": "node versioning.js --auto",
    "version:patch": "node versioning.js --patch",
    "version:minor": "node versioning.js --minor",
    "version:major": "node versioning.js --major",
    "version:preview": "node versioning.js --preview"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo-google-fonts/cairo": "^0.1.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/drawer": "^7.5.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.5",
    "@react-navigation/web": "^1.0.0-alpha.9",
    "adhan": "^4.4.3",
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "jszip": "^3.10.1",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "moment-timezone": "^0.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-shared-group-preferences": "1.1.24",
    "react-native-svg": "15.15.4",
    "react-native-swiper": "^1.6.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-web-swiper": "^2.2.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "gh-pages": "^6.3.0",
    "jest": "~29.7.0",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "name": "zikr",
  "version": "1.1.26",
  "packageManager": "yarn@3.6.4",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-shared-group-preferences"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
